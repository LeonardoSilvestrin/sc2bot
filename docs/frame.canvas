		{"id":"game","type":"text","text":"## Jogo\nStarCraft II pelo python-sc2, com o **Ares** por baixo: placement, pathing, grids de perigo e os macro behaviors que o Body usa.","x":400,"y":-1280,"width":3220,"height":180}
	],
