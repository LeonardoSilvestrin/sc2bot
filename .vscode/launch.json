{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "sem logs nem view",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\run.py",
      "cwd": "${workspaceFolder}",
      "args": ["--bot-log", "off"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "só logs",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\run.py",
      "cwd": "${workspaceFolder}",
      "args": ["--bot-log", "events"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "logs e view",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\run.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "--bot-log",
        "events",
        "--spatial-view",
        "--spatial-view-spacing",
        "5"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "logs e snapshot SVG",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\run.py",
      "cwd": "${workspaceFolder}",
      "args": ["--bot-log", "events", "--spatial-snapshot"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "logs, view e snapshot SVG",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\run.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "--bot-log",
        "events",
        "--spatial-view",
        "--spatial-view-spacing",
        "5",
        "--spatial-snapshot"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "log visualizer",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\scripts\\open_log_viewer.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "abrir worktree de agente",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\_botdev\\agent.ps1\" ${input:agentName}"
    }
  ],
  "inputs": [
    {
      "id": "agentName",
      "type": "promptString",
      "description": "Nome do agente (worktree agents/<nome>). Reseta pro último commit da branch atual.",
      "default": "claude"
    }
  ]
}
